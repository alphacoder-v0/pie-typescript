# Pinned upstream revisions. These must not drift during the migration.
#
# The directory variables point at local checkouts of the upstream repositories.
# They are read from the environment so that this file stays machine independent.
# Set them before running the coverage gates or the parity harness:
#
#   export UPSTREAM_ORACLE_DIR=/path/to/pie-checkout
#   export UPSTREAM_SKELETON_DIR=/path/to/pi-checkout
#
# When a variable is unset the gate that needs it reports SKIP instead of failing,
# so a clean clone still passes `npm run check` without any checkout present.

ORACLE_PIE_SHA=0a120dfd380fb7f009e09f2b7981b76c07b3fd95
ORACLE_PIE_DIR=${UPSTREAM_ORACLE_DIR:-}

SKELETON_PI_SHA=4868222e3414554987bf4b05fbb393fc65080aa0
SKELETON_PI_DIR=${UPSTREAM_SKELETON_DIR:-}

REF_PI_V075_SHA=12f5c00cc1332e04d18e2120b71731627174bcc7
REF_PI_V075_DIR=${UPSTREAM_PI_V075_DIR:-}

REF_PI_CURRENT_SHA=4c01c709380621c5ff2719162cd7a7973dcb2799
REF_PI_CURRENT_DIR=${UPSTREAM_PI_CURRENT_DIR:-}
